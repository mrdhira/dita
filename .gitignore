# Secret / Credentials
*.env

# Runtime directories are bind-mounted into the containers. The directories themselves
# are kept in git via .gitkeep; everything that lands inside them at runtime is not.
run/*
!run/.gitkeep

# Model weights are never committed. They are fetched into the mounted models directory
# and pinned by each service's models.yaml.
services/inferences-*/models/*
!services/inferences-*/models/.gitkeep

# Compiled Go binaries: the example (`go build` names it after its directory) and
# `make build` in the orchestrator.
services/inferences-ocr/examples/go/go
services/dita-orchestrator/bin/

# Go coverage profiles, written by each unit's `make coverage` so the floor can read a
# total. The Python equivalent, .coverage, is ignored below.
coverage.out

# Python. uv.lock is deliberately NOT here -- it is committed.
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.coverage
htmlcov/

# JS: dependencies, build output, and what vitest and Playwright write. pnpm-lock.yaml is
# deliberately NOT here -- it is committed beside the app.
node_modules/
services/inferences-dashboard/dist/
services/inferences-dashboard/coverage/
services/inferences-dashboard/test-results/
services/inferences-dashboard/playwright-report/
services/inferences-dashboard/*.tsbuildinfo
